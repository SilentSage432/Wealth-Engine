# Supabase (Phase 3 Path A) — copy to `.env.local` and fill from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alias (used if publishable key is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server routes ONLY (never NEXT_PUBLIC_*)
# Required for /api/plaid/exchange-token to persist access_token.
# SUPABASE_SERVICE_ROLE_KEY=

# Plaid (Path B) — secrets stay server-side in app/api/plaid/* + lib/babylon/plaid-server.ts
# NEXT_PUBLIC_PLAID_ENV=sandbox
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
